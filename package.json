{
  "name": "soporte-tecnico",
  "version": "1.0.0",
  "private": true,
  "description": "Aplicacion web full stack para la gestion de solicitudes internas de soporte tecnico",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @soporte/api",
    "dev:web": "npm run dev --workspace @soporte/web",
    "build": "npm run build --workspace @soporte/shared && npm run build --workspace @soporte/api && npm run build --workspace @soporte/web",
    "start": "concurrently -n api,web -c blue,green \"npm:start:api\" \"npm:start:web\"",
    "start:api": "npm run start --workspace @soporte/api",
    "start:web": "npm run start --workspace @soporte/web",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @soporte/api",
    "test:coverage": "npm run test:coverage --workspace @soporte/api",
    "db:migrate": "npm run db:migrate --workspace @soporte/api",
    "db:seed": "npm run db:seed --workspace @soporte/api",
    "db:reset": "npm run db:reset --workspace @soporte/api"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.18.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  }
}
