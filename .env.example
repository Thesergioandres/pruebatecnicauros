# Copy to .env and fill real values. Never commit .env.
DATABASE_URL="postgresql://tickets:tickets_dev@localhost:5433/tickets?schema=public"

# Resend (email notifications). Get a key at https://resend.com/api-keys
# Leave empty to run with notifications disabled (events are logged, not sent).
RESEND_API_KEY=""
# Sender shown in notification emails. In Resend test mode without a verified
# domain, keep onboarding@resend.dev (delivers only to the account owner).
RESEND_FROM="onboarding@resend.dev"

APP_URL="http://localhost:3000"
