# ---- Base de datos (PostgreSQL 16) ----
DATABASE_URL=postgresql://tickets:tickets_dev@localhost:5433/tickets
DATABASE_POOL_MAX=10

# ---- Backend (Express 5) ----
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=debug

# Secreto de firma de la cookie de sesion. Cambiar en produccion: minimo 32 caracteres.
JWT_SECRET=cambia-este-secreto-por-uno-aleatorio-de-32-caracteres
SESSION_COOKIE_NAME=soporte_session
SESSION_TTL_HOURS=8

# Origen permitido por CORS. Solo aplica si se consume la API desde otro
# origen.
CORS_ORIGIN=http://localhost:3000

# ---- Frontend (Next.js) ----
WEB_PORT=3000

# URL de la API tal como la ve el servidor de Next. El navegador nunca la llama
# directamente: todo pasa por el proxy same-origin /api -> API_INTERNAL_URL,
# de modo que la cookie de sesion sea same-origin y httpOnly.
API_INTERNAL_URL=http://localhost:4000

# ---- Notificaciones (Resend, solo servidor) ----
# Clave de API de Resend (https://resend.com). Vacia = notificaciones
# deshabilitadas. Solo el backend la lee; nunca la expongas al frontend.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=onboarding@resend.dev

# ---- Seed usuarios iniciales (solo desarrollo) ----
# El script de seed usa estas variables para crear el primer ADMIN y un
# USER de pruebas. Son obligatorias en produccion (el script rechaza correr
# con valores de marcador si NODE_ENV=production). Nunca incluyas valores
# reales aqui: este archivo es la plantilla; los valores reales viven en
# .env, que esta en .gitignore.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=cambia-esta-clave-semilla
SEED_USER_EMAIL=user@example.com
SEED_USER_PASSWORD=cambia-esta-clave-semilla
NOTIFY_NEW_TICKET_TO=avisa@tudominio.com
